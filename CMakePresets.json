{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug build",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QUANTUM_SHELL_SANITIZERS": "ON"
      }
    },
    {
      "name": "session",
      "displayName": "Debug build with the tests that need a live machine registered",
      "binaryDir": "${sourceDir}/build/session",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "environment": {
        "QS_NIRI_SESSION_TESTS": "1",
        "QS_NIRI_RESTART_TESTS": "1",
        "QS_AUDIO_TESTS": "1"
      }
    },
    {
      "name": "ci",
      "displayName": "Release build used by continuous integration",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "session",
      "configurePreset": "session"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "session",
      "configurePreset": "session",
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^(niri-live-(action|layershell|restart|shell-restart)-test)$"
        },
        "match": "regex"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
